<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NATIVOS</title>

    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NATIVOS.styles.css" asp-append-version="true" />
    

</head>

<body>

    
    <header class="navbar-custom">

        <div class="logo">
            <img src="~/Images/logo.png" alt="NATIVOS">
        </div>

        <nav>
            <a asp-controller="Home" asp-action="Index">Inicio</a>
            <a asp-controller="Destinos" asp-action="Index">Destinos</a>
            <a href="#">Experiencias</a>
            <a href="#">Tradiciones</a>
            <a href="#">Sobre Nosotros</a>
            <a href="#">Contacto</a>
        </nav>

        <a href="#" class="login-btn">
            Ingresar
        </a>

    </header>

    <main>
        @RenderBody()
    </main>
    

</body>
</html>
