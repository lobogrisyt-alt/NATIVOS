@{
    ViewData["Title"] = "Experiencias";
}

<div class="hero-banner">
    <div class="hero-overlay">

        <h1>Experiencias en Nicaragua</h1>

        <p>
            Descubre los mejores destinos turísticos,
            volcanes, playas, ciudades coloniales y aventuras.
        </p>

    </div>
</div>

<div class="contenedor">

    <div class="card">

        <img src="/Images/granada.png" alt="Granada">

        <div class="contenido">

            <h2>Granada</h2>

            <p>
                Ciudad colonial llena de historia
                conocida como "La Gran Sultana", fue
                fundada en 1524 destacando por su
                arquitectura, cultura y sus
                calles empredradas. ven y 
                Disfruta de las Isletas, paseos
                en lancha y gastronomía típica.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Paseo en lancha</li>
                <li>Tour histórico</li>
                <li>Guía turístico</li>
            </ul>

            <div class="precio">
                Desde C$1,250 por persona
            </div>

        </div>

    </div>

    <div class="card">

        <img src="/Images/Leon.jpg" alt="Leon">

        <div class="contenido">

            <h2>León</h2>

            <p>
                Leon, fundada en 1524 por
                Francisco Hernández de Córdobas, es
                la segunda ciudad más importante
                de Nicaragua y Centro cultural.
                Visita la Catedral de León, museos
                 y practica sandboarding.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Catedral de León</li>
                <li>Museos</li>
                <li>Sandboarding</li>
            </ul>

            <div class="precio">
                Desde C$1,100 por persona
            </div>

        </div>


    </div>

    <div class="card">

        <img src="/Images/laguna de apoyo.jpg" alt="Laguna de Apoyo">

        <div class="contenido">

            <h2>Laguna de Apoyo</h2>

            <p>
                La Laguna de Apoyo es una reserva natural ubicada
                entre Granada y Masaya. Sus aguas cristalinas de origen
                volcánico la convierten en uno de los destinos más
                relajantes de Nicaragua, ideal para nadar, practicar kayak
                y disfrutar de la naturaleza.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Acceso a la laguna</li>
                <li>Kayak y natación</li>
                <li>Senderos ecológicos</li>
                <li>Miradores panorámicos</li>
            </ul>

            <div class="precio">
                Desde C$950 por persona
            </div>

        </div>

    </div>

    <div class="card">

        <img src="/Images/reserva natural.jpg" alt="Reserva Natural Tisey">

        <div class="contenido">

            <h2>Reserva Natural Tisey</h2>

            <p>
                Situada en Estelí, esta reserva ofrece impresionantes paisajes,
                bosques de pino, senderos naturales y el famoso Salto de La Estanzuela.
                Es un destino ideal para el ecoturismo.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Visita al Salto La Estanzuela</li>
                <li>Senderismo</li>
                <li>Miradores naturales</li>
                <li>Observación de flora y fauna</li>
            </ul>

            <div class="precio">
                Desde C$950 por persona
            </div>

        </div>

    </div>

    <div class="card">

        <img src="/Images/selva negra.jpg" alt="Selva Negra">

        <div class="contenido">

            <h2>Selva Negra</h2>

            <p>
                Ubicada en las montañas de Matagalpa, Selva Negra es una
                reserva ecológica y finca cafetalera rodeada de bosques
                nubosos. Es el lugar ideal para disfrutar de la naturaleza,
                observar aves exóticas y conocer el proceso de producción
                del café nicaragüense.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Tour por cafetales</li>
                <li>Senderismo ecológico</li>
                <li>Observación de aves</li>
                <li>Recorrido por el bosque nuboso</li>
            </ul>

            <div class="precio">
                Desde C$1,300 por persona
            </div>

        </div>

    </div>

    <div class="card">

        <img src="/Images/Ometepe.jpg" alt="Isla de Ometepe">

        <div class="contenido">

            <h2>Isla de Ometepe</h2>

            <p>
                Isla volcánica formada por los volcanes
                Concepción y Maderas, es la isla más grande
                del mundo en un lago de agua dulce y declarada
                reserva de la Biosfera por la UNESCO.
                Naturaleza, senderismo y playas.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Volcán Concepción</li>
                <li>Ojo de Agua</li>
                <li>Charco Verde</li>
            </ul>

            <div class="precio">
                Desde C$1,850 por persona
            </div>

        </div>



    </div>

</div>
