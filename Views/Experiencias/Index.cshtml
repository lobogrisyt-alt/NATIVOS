@{
    ViewData["Title"] = "Experiencias";
}

<div class="hero-banner">
    <div class="hero-overlay">

        <h1>Experiencias en Nicaragua</h1>

        <p>
            Descubre los mejores destinos turísticos,
            volcanes, playas, ciudades coloniales y aventuras.
        </p>

    </div>
</div>

<section class="seccion-populares">

    <h2 class="titulo-populares">
        <span class="decoracion">❈</span>
        Destinos más visitados
        <span class="decoracion">❈</span>
    </h2>

    <p class="descripcion-populares">
        Explora los destinos más populares de Nicaragua y vive experiencias inolvidables.
    </p>

</section>

<div class="contenedor">

    <div class="card">

        <img src="/Images/granada.jpeg" alt="Granada">

        <div class="contenido">

            <h2>Granada</h2>

            <p>
                Ciudad colonial llena de historia
                conocida como "La Gran Sultana", fue
                fundada en 1524 destacando por su
                arquitectura, cultura y sus
                calles empredradas. ven y 
                Disfruta de las Isletas, paseos
                en lancha y gastronomía típica.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Paseo en lancha</li>
                <li>Tour histórico</li>
                <li>Guía turístico</li>
            </ul>

            <div class="precio">
                Desde C$1,250 por persona
            </div>

            <a asp-controller="Experiencias"
                asp-action="Mapa"
                asp-route-lugar="granada"
                class="btn-vermas">
                Ver más
            </a>

        </div>

    </div>

    <div class="card">

        <img src="/Images/Leon.jpg" alt="Leon">

        <div class="contenido">

            <h2>León</h2>

            <p>
                Leon, fundada en 1524 por
                Francisco Hernández de Córdobas, es
                la segunda ciudad más importante
                de Nicaragua y Centro cultural.
                Visita la Catedral de León, museos
                 y practica sandboarding.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Catedral de León</li>
                <li>Museos</li>
                <li>Sandboarding</li>
            </ul>

            <div class="precio">
                Desde C$1,100 por persona
            </div>

            <a asp-controller="Experiencias"
               asp-action="Mapa"
               asp-route-lugar="leon"
               class="btn-vermas">
                Ver más
            </a>

        </div>


    </div>

    <div class="card">

        <img src="/Images/laguna de apoyo.jpg" alt="Laguna de Apoyo">

        <div class="contenido">

            <h2>Laguna de Apoyo</h2>

            <p>
                La Laguna de Apoyo es una reserva natural ubicada
                entre Granada y Masaya. Sus aguas cristalinas de origen
                volcánico la convierten en uno de los destinos más
                relajantes de Nicaragua, ideal para nadar, practicar kayak
                y disfrutar de la naturaleza.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Acceso a la laguna</li>
                <li>Kayak y natación</li>
                <li>Senderos ecológicos</li>
                <li>Miradores panorámicos</li>
            </ul>

            <div class="precio">
                Desde C$950 por persona
            </div>

            <a asp-controller="Experiencias"
               asp-action="Mapa"
               asp-route-lugar="apoyo"
               class="btn-vermas">
                Ver más
            </a>

        </div>

    </div>

    <div class="card">

        <img src="/Images/reserva natural.jpg" alt="Reserva Natural Tisey">

        <div class="contenido">

            <h2>Reserva Natural Tisey</h2>

            <p>
                Situada en Estelí, esta reserva ofrece impresionantes paisajes,
                bosques de pino, senderos naturales y el famoso Salto de La Estanzuela.
                Es un destino ideal para el ecoturismo.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Visita al Salto La Estanzuela</li>
                <li>Senderismo</li>
                <li>Miradores naturales</li>
                <li>Observación de flora y fauna</li>
            </ul>

            <div class="precio">
                Desde C$950 por persona
            </div>

            <a asp-controller="Experiencias"
                asp-action="Mapa"
                asp-route-lugar="tisey"
                class="btn-vermas">
                Ver más
            </a>

        </div>

    </div>

    <div class="card">

        <img src="/Images/selva negra.jpg" alt="Selva Negra">

        <div class="contenido">

            <h2>Selva Negra</h2>

            <p>
                Ubicada en las montañas de Matagalpa, Selva Negra es una
                reserva ecológica y finca cafetalera rodeada de bosques
                nubosos. Es el lugar ideal para disfrutar de la naturaleza,
                observar aves exóticas y conocer el proceso de producción
                del café nicaragüense.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Tour por cafetales</li>
                <li>Senderismo ecológico</li>
                <li>Observación de aves</li>
                <li>Recorrido por el bosque nuboso</li>
            </ul>

            <div class="precio">
                Desde C$1,300 por persona
            </div>

            <a asp-controller="Experiencias"
               asp-action="Mapa"
               asp-route-lugar="selvanegra"
               class="btn-vermas">
                Ver más
            </a>

        </div>

    </div>

    <div class="card">

        <img src="/Images/Ometepe.jpg" alt="Isla de Ometepe">

        <div class="contenido">

            <h2>Isla de Ometepe</h2>

            <p>
                Isla volcánica formada por los volcanes
                Concepción y Maderas, es la isla más grande
                del mundo en un lago de agua dulce y declarada
                reserva de la Biosfera por la UNESCO.
                Naturaleza, senderismo y playas.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Volcán Concepción</li>
                <li>Ojo de Agua</li>
                <li>Charco Verde</li>
            </ul>

            <div class="precio">
                Desde C$1,850 por persona
            </div>

            <a asp-controller="Experiencias"
                asp-action="Mapa"
                asp-route-lugar="ometepe"
                class="btn-vermas">
                Ver más
            </a>

        </div>



    </div>

    <div class="card">

        <img src="/Images/somoto.jpg" alt="Cañón de Somoto">

        <div class="contenido">

            <h2>Cañón de Somoto</h2>

            <p>
                Ubicado en Madriz, el Cañón de Somoto es uno de los
                tesoros naturales más impresionantes de Nicaragua.
                Sus enormes formaciones rocosas, aguas cristalinas
                y recorridos en lancha ofrecen una aventura única
                para quienes aman la naturaleza.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Recorrido por el cañón</li>
                <li>Paseo en lancha</li>
                <li>Natación</li>
                <li>Guía certificado</li>
            </ul>

            <div class="precio">
                Desde C$1,450 por persona
            </div>

            <a asp-controller="Experiencias"
               asp-action="Mapa"
               asp-route-lugar="somoto"
               class="btn-vermas">
                Ver más
            </a>

        </div>

    </div>

    <div class="card">

        <img src="/Images/san_juan_del_sur.jpg" alt="San Juan del Sur">

        <div class="contenido">

            <h2>San Juan del Sur</h2>

            <p>
                San Juan del Sur es uno de los destinos turísticos
                más visitados de Nicaragua. Sus playas, ambiente
                relajado y espectaculares atardeceres lo convierten
                en el lugar perfecto para disfrutar del mar y la
                gastronomía local.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Tour por la bahía</li>
                <li>Mirador del Cristo</li>
                <li>Playa</li>
                <li>Gastronomía local</li>
            </ul>

            <div class="precio">
                Desde C$1,350 por persona
            </div>

            <a asp-controller="Experiencias"
               asp-action="Mapa"
               asp-route-lugar="sanjuandelsur"
               class="btn-vermas">
                Ver más
            </a>

        </div>

    </div>
</div>

<section class="division-rural">

        <svg class="onda-superior" viewBox="0 0 1440 120" preserveAspectRatio="none">

            <path fill="#5d6d1d"
                  d="M0,75
                C120,20 240,120 360,75
                C480,30 600,120 720,75
                C840,20 960,120 1080,75
                C1200,30 1320,120 1440,75
                L1440,120
                L0,120
                Z">
            </path>

        </svg>

    <div class="titulo-rural">

        <h2>
            <span>❈</span>
            Turismo rural y comunitario
            <span>❈</span>
        </h2>

        <p>
            Descubre lugares auténticos, apoya a las comunidades locales
            y vive el turismo sostenible en su máxima expresión.
        </p>

    </div>

</section>

<div class="contenedor-rural">

    <div class="card-rural">

        <img src="/Images/parque-el-cerrito.jpg" alt="Parque El Cerrito">

        <div class="contenido">

            <h2>Parque El Cerrito</h2>

            <p>
                Ubicado en la ciudad de Boaco, el Parque El Cerrito es uno de los
                principales atractivos turísticos del departamento. Este hermoso
                mirador alberga el famoso Faro Visionario, desde donde podrás
                contemplar una vista panorámica de la ciudad, disfrutar de la
                naturaleza y vivir una experiencia auténtica en el corazón de
                Nicaragua.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Acceso al Parque El Cerrito</li>
                <li>Visita al Faro Visionario</li>
                <li>Mirador panorámico de Boaco</li>
                <li>Guía turístico local</li>
            </ul>

            <div class="precio">
                Desde C$450 por persona
            </div>

            <a asp-controller="Experiencias"
               asp-action="Mapa"
               asp-route-lugar="elcerrito"
               class="btn-vermas">
                Ver más
            </a>

        </div>


    </div>
    <div class="card">

        <img src="/Images/los-guatuzos.jpg" alt="Refugio de Vida Silvestre Los Guatuzos">

        <div class="contenido">

            <h2>Refugio de Vida Silvestre Los Guatuzos</h2>

            <p>
                Ubicado en el departamento de Río San Juan, el Refugio de Vida
                Silvestre Los Guatuzos es una de las áreas protegidas más importantes
                de Nicaragua. Sus bosques, humedales y ríos albergan una gran
                diversidad de flora y fauna, convirtiéndolo en un destino ideal para
                el ecoturismo y la observación de la naturaleza.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Senderismo por la reserva</li>
                <li>Observación de aves y fauna silvestre</li>
                <li>Recorrido por puentes colgantes</li>
                <li>Guía turístico local</li>
            </ul>

            <div class="precio">
                Desde C$500 por persona
            </div>

            <a asp-controller="Experiencias"
               asp-action="Mapa"
               asp-route-lugar="losguatuzos"
               class="btn-vermas">
                Ver más
            </a>

        </div>

    </div>
    <div class="card">

        <img src="/Images/castillo-inmaculada.jpg" alt="Castillo de la Inmaculada Concepción">

        <div class="contenido">

            <h2>Castillo de la Inmaculada Concepción</h2>

            <p>
                Ubicado a orillas del río San Juan, este histórico castillo fue
                construido en el siglo XVII para proteger el territorio de los
                ataques piratas. Actualmente es uno de los monumentos históricos
                más importantes de Nicaragua, donde podrás conocer su historia,
                disfrutar de impresionantes vistas y recorrer sus antiguas murallas.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Recorrido por el castillo</li>
                <li>Visita al museo histórico</li>
                <li>Miradores al río San Juan</li>
                <li>Guía turístico local</li>
            </ul>

            <div class="precio">
                Desde C$600 por persona
            </div>

            <a asp-controller="Experiencias"
               asp-action="Mapa"
               asp-route-lugar="castillo"
               class="btn-vermas">
                Ver más
            </a>

        </div>

    </div>
    <div class="card">

        <img src="/Images/indio-maiz.jpg" alt="Reserva Biológica Indio Maíz">

        <div class="contenido">

            <h2>Reserva Biológica Indio Maíz</h2>

            <p>
                Ubicada entre Río San Juan y la Costa Caribe Sur, la Reserva
                Biológica Indio Maíz es una de las selvas tropicales mejor
                conservadas de Centroamérica. Sus exuberantes bosques, ríos y
                humedales albergan una extraordinaria diversidad de flora y fauna,
                convirtiéndola en un destino ideal para los amantes de la naturaleza
                y el ecoturismo.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Recorrido por senderos naturales</li>
                <li>Observación de aves y fauna silvestre</li>
                <li>Paseo en lancha por los ríos</li>
                <li>Guía turístico especializado</li>
            </ul>

            <div class="precio">
                Desde C$700 por persona
            </div>

            <a asp-controller="Experiencias"
               asp-action="Mapa"
               asp-route-lugar="indiomaiz"
               class="btn-vermas">
                Ver más
            </a>

        </div>

    </div>
    <div class="card">

        <img src="/Images/huellas-acahualinca.jpg" alt="Huellas de Acahualinca">

        <div class="contenido">

            <h2>Huellas de Acahualinca</h2>

            <p>
                Ubicadas en Managua, las Huellas de Acahualinca son uno de los
                sitios arqueológicos más importantes de Centroamérica. Estas
                huellas humanas, preservadas en ceniza volcánica desde hace más
                de 6,000 años, permiten conocer parte de la historia prehistórica
                de Nicaragua y representan un invaluable patrimonio cultural.
            </p>

            <h4>Incluye:</h4>

            <ul>
                <li>Recorrido por el museo</li>
                <li>Observación de las huellas originales</li>
                <li>Exposición arqueológica</li>
                <li>Guía turístico especializado</li>
            </ul>

            <div class="precio">
                Desde C$350 por persona
            </div>

            <a asp-controller="Experiencias"
               asp-action="Mapa"
               asp-route-lugar="acahualinca"
               class="btn-vermas">
                Ver más
            </a>

        </div>

    </div>
</div>

