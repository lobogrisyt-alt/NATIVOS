@{
    ViewData["Title"] = "Mapa Interactivo";
    var lugar = (ViewBag.Lugar ?? "").ToString().ToLower();
}

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

<style>
    .contenedor-mapa{
        max-width:930px;
        margin:40px auto;
        padding:20px;
    }

    h1{
        text-align:center;
        margin-bottom:10px;
        color: #5d6d1d;
    }

    p{
        text-align:center;
        color:#666;
        margin-bottom:25px;
    }

    #map{
        width:100%;
        height:650px;
        border-radius:15px;
        box-shadow:0 5px 15px rgba(0,0,0,.25);
    }

    .btn-regresar{
        display:inline-block;
        margin-top:25px;
        padding:12px 25px;
        background: #5d6d1d;
        color:white;
        text-decoration:none;
        border-radius:8px;
        font-weight:bold;
        transition:.3s;
    }

    .btn-regresar:hover{
            background: #5d6d1d;
    }
</style>

<div class="contenedor-mapa">


    <p>Explora el destino seleccionado y descubre su ubicación.</p>

    <div id="map"></div>

    <div class="botones">

        <a asp-controller="Experiencias"
           asp-action="Reservar"
           asp-route-lugar="@lugar"
           class="btn-reservar">

            🛒 Reservar Ahora

        </a>

        <a asp-controller="Experiencias"
           asp-action="Index"
           class="btn-regresar">
            ← Regresar
        </a>

    </div>

</div>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<script>

    let lat = 12.8654;
    let lng = -85.2072;
    let zoom = 7;
    let texto = "Nicaragua";

    switch("@lugar"){

        case "granada":
            lat=11.93157;
            lng=-85.95602;
            zoom=17;
            texto="<b>Granada</b><br>La Gran Sultana";
        break;

        case "leon":
            lat=12.434982;
            lng=-86.878102;
            zoom=17;
            texto="<b>Catedral de León</b><br>León, Nicaragua";
        break;

        case "apoyo":
            lat=11.9138;
            lng=-86.0444;
            zoom=14;
            texto="<b>Laguna de Apoyo</b>";
        break;

        case "tisey":
            lat=13.02198;
            lng=-86.38840;
            zoom=16;
            texto="<b>Reserva Natural Tisey-La Estanzuela</b><br>Estelí, Nicaragua";
        break;

        case "selvanegra":
            lat=12.99893;
            lng=-85.90978;
            zoom=18;
            texto="<b>Selva Negra</b><br>Hotel de Montaña, Matagalpa";
        break;

        case "ometepe":
            lat=11.5122;
            lng=-85.5736;
            zoom=11;
            texto="<b>Isla de Ometepe</b>";
        break;
    }

    var map = L.map('map').setView([lat,lng],zoom);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
        attribution:'© OpenStreetMap'
    }).addTo(map);

    L.marker([lat,lng])
    .addTo(map)
    .bindPopup(texto)
    .openPopup();

</script>