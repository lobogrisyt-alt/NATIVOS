@{
    ViewData["Title"] = "Mapa Interactivo";
    var lugar = (ViewBag.Lugar ?? "").ToString().ToLower();
}

<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />

<style>
    .contenedor-mapa{
        max-width:930px;
        margin:40px auto;
        padding:20px;
    }

    h1{
        text-align:center;
        margin-bottom:10px;
        color: #5d6d1d;
    }

    p{
        text-align:center;
        color:#666;
        margin-bottom:25px;
    }

    #map{
        width:100%;
        height:650px;
        border-radius:15px;
        box-shadow:0 5px 15px rgba(0,0,0,.25);
    }

    .btn-regresar{
        display:inline-block;
        margin-top:25px;
        padding:12px 25px;
        background: #5d6d1d;
        color:white;
        text-decoration:none;
        border-radius:8px;
        font-weight:bold;
        transition:.3s;
    }

    .btn-regresar:hover{
            background: #5d6d1d;
    }
</style>

<div class="contenedor-mapa">


    <p>Explora el destino seleccionado y descubre su ubicación.</p>

    <div id="map"></div>

    <div class="botones">

        <a asp-controller="Experiencias"
           asp-action="Reservar"
           asp-route-lugar="@lugar"
           class="btn-reservar">

            🛒 Reservar Ahora

        </a>

        <a asp-controller="Experiencias"
           asp-action="Index"
           class="btn-regresar">
            ← Regresar
        </a>

    </div>

</div>

<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<script>

    let lat = 12.8654;
    let lng = -85.2072;
    let zoom = 7;
    let texto = "Nicaragua";

    switch("@lugar"){

        case "granada":
            lat=11.93157;
            lng=-85.95602;
            zoom=17;
            texto="<b>Granada</b><br>La Gran Sultana";
        break;

        case "leon":
            lat=12.434982;
            lng=-86.878102;
            zoom=17;
            texto="<b>Catedral de León</b><br>León, Nicaragua";
        break;

        case "apoyo":
            lat=11.9138;
            lng=-86.0444;
            zoom=14;
            texto="<b>Laguna de Apoyo</b>";
        break;

        case "tisey":
            lat=13.02198;
            lng=-86.38840;
            zoom=16;
            texto="<b>Reserva Natural Tisey-La Estanzuela</b><br>Estelí, Nicaragua";
        break;

        case "selvanegra":
            lat=12.99893;
            lng=-85.90978;
            zoom=18;
            texto="<b>Selva Negra</b><br>Hotel de Montaña, Matagalpa";
        break;

        case "ometepe":
            lat=11.5122;
            lng=-85.5736;
            zoom=11;
            texto="<b>Isla de Ometepe</b>";
        break;

        case "sanjuandelsur":
            lat = 11.2523;
            lng = -85.8708;
            zoom = 15;
            texto = "<b>San Juan del Sur</b><br>Rivas, Nicaragua";
            break;

        case "ometepe":
            lat = 11.5122;
            lng = -85.5736;
            zoom = 11;
            texto = "<b>Isla de Ometepe</b>";
            break;

        case "somoto":
            lat = 13.4809;
            lng = -86.5825;
            zoom = 15;
            texto = "<b>Cañón de Somoto</b><br>Madriz, Nicaragua";
            break;

        case "acahualinca":
           lat = 12.1601;
           lng = -86.2944;
           zoom = 16;
           texto = "<b>Huellas de Acahualinca</b><br>Managua, Nicaragua";
           break;

        case "indiomaiz":
           lat = 11.0824;
           lng = -84.0951;
           zoom = 11;
           texto = "<b>Reserva Biológica Indio Maíz</b><br>Río San Juan, Nicaragua";
           break;

        case "elcerrito":
           lat = 12.4733;
           lng = -85.6619;
           zoom = 17;
           texto = "<b>Parque El Cerrito (El Faro)</b><br>Boaco, Nicaragua";
           break;

        case "castillo":
           lat = 11.0192;
           lng = -84.3965;
           zoom = 16;
           texto = "<b>Castillo de la Inmaculada Concepción</b><br>El Castillo, Río San Juan, Nicaragua";
           break;

        case "losguatuzos":
           lat = 11.0333;
           lng = -84.8000;
           zoom = 12;
           texto = "<b>Refugio de Vida Silvestre Los Guatuzos</b><br>Río San Juan, Nicaragua";
           break;

        case "volcanmombacho":
           lat = 11.8261;
           lng = -85.9678;
           zoom = 13;
           texto = "<b>Reserva Natural Volcán Mombacho</b><br>Granada, Nicaragua";
           break;

        case "riosanjuan":
           lat = 11.1314;
           lng = -84.7780;
           zoom = 11;
           texto = "<b>Río San Juan y Comunidades Ribereñas</b><br>Río San Juan, Nicaragua";
           break;

        case "salto-el-rosario":
           lat = 13.7573;
           lng = -86.0194;
           zoom = 13;
           texto = "<b>Salto El Rosario</b><br>Murra, Nueva Segovia, Nicaragua";
           break;

        case "lafundadora":
           lat = 13.0117;
           lng = -85.9328;
           zoom = 13;
           texto = "<b>La Fundadora</b><br>Jinotega, Nicaragua";
           break;



    }

    var map = L.map('map').setView([lat,lng],zoom);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
        attribution:'© OpenStreetMap'
    }).addTo(map);

    L.marker([lat,lng])
    .addTo(map)
    .bindPopup(texto)
    .openPopup();

</script>