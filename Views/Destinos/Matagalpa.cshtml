@{
    ViewData["Title"] = "Matagalpa";
}

<section class="destino-detalle">

    <div class="destino-banner">
        <img src="/Images/leon.png" alt="Matagalpa">
    </div>

    <div class="destino-info">

        <h1>Matagalpa</h1>

        <p>
            Conocida como la Perla del Norte,
            Matagalpa ofrece montañas, café de calidad mundial
            y un clima fresco durante todo el año.
        </p>

        <h2>¿Qué puedes hacer?</h2>

        <ul>
            <li>Visitar fincas cafetaleras.</li>
            <li>Conocer cascadas y senderos.</li>
            <li>Explorar reservas naturales.</li>
            <li>Disfrutar del clima de montaña.</li>
        </ul>

        <a asp-controller="Destinos"
           asp-action="Index"
           class="destino-btn">
            Volver a Destinos
        </a>

    </div>

</section>
<section class="destino-galeria">

    <h2>Lugares Imperdibles</h2>

    <div class="galeria-grid">

        <div class="galeria-card">
            <img src="/Images/cascada-blanca.jpg" alt="Cascada Blanca">
            <h3>Cascada Blanca</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/cerro-apante.jpg" alt="Cerro Apante">
            <h3>Cerro Apante</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/finca-cafe.jpg" alt="Finca Cafetalera">
            <h3>Fincas Cafetaleras</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/selva-negra.jpg" alt="Selva Negra">
            <h3>Selva Negra</h3>
        </div>

    </div>

    <h2>Gastronomía Típica</h2>

    <div class="galeria-grid">

        <div class="galeria-card">
            <img src="/Images/cafe-matagalpa.jpg" alt="Café de Matagalpa">
            <h3>Café de Matagalpa</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/rosquillas.jpg" alt="Rosquillas">
            <h3>Rosquillas</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/nacatamal.jpg" alt="Nacatamal">
            <h3>Nacatamal</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/gallo-pinto.jpg" alt="Gallo Pinto">
            <h3>Gallo Pinto</h3>
        </div>

    </div>

</section>