@{
    ViewData["Title"] = "Ometepe";
}

<section class="destino-detalle">

    <div class="destino-banner">
        <img src="/Images/ometepe.png" alt="Ometepe">
    </div>

    <div class="destino-info">

        <h1>Isla de Ometepe</h1>

        <p>
            Ometepe es una isla formada por dos volcanes en medio del Lago Cocibolca.
            Es uno de los destinos naturales más impresionantes de Nicaragua.
        </p>

        <h2>¿Qué puedes hacer?</h2>

        <ul>
            <li>Subir los volcanes Concepción y Maderas.</li>
            <li>Visitar Ojo de Agua.</li>
            <li>Conocer petroglifos antiguos.</li>
            <li>Disfrutar de paisajes únicos.</li>
        </ul>

        <a asp-controller="Destinos"
           asp-action="Index"
           class="destino-btn">
            Volver a Destinos
        </a>

    </div>

</section>

<section class="destino-galeria">

    <h2>Lugares Imperdibles</h2>

    <div class="galeria-grid">

        <div class="galeria-card">
            <img src="/Images/volcan-concepcion.jpg" alt="Volcán Concepción">
            <h3>Volcán Concepción</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/volcan-maderas.jpg" alt="Volcán Maderas">
            <h3>Volcán Maderas</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/ojo-de-agua.jpg" alt="Ojo de Agua">
            <h3>Ojo de Agua</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/punta-jesus-maria.jpg" alt="Punta Jesús María">
            <h3>Punta Jesús María</h3>
        </div>

    </div>

    <h2>Gastronomía Típica</h2>

    <div class="galeria-grid">

        <div class="galeria-card">
            <img src="/Images/pescado-frito.jpg" alt="Pescado Frito">
            <h3>Pescado Frito</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/sopa-mariscos.jpg" alt="Sopa de Mariscos">
            <h3>Sopa de Mariscos</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/quesillo.jpg" alt="Quesillo">
            <h3>Quesillo</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/gallo-pinto.jpg" alt="Gallo Pinto">
            <h3>Gallo Pinto</h3>
        </div>

    </div>

</section>