@{
    ViewData["Title"] = "Corn Island";
}

<section class="destino-detalle">

    <div class="destino-banner">
        <img src="/Images/ometepe.png" alt="Corn Island">
    </div>

    <div class="destino-info">

        <h1>Corn Island</h1>

        <p>
            Ubicada en el Caribe nicaragüense,
            Corn Island es famosa por sus aguas cristalinas,
            arrecifes y ambiente tropical.
        </p>

        <h2>¿Qué puedes hacer?</h2>

        <ul>
            <li>Bucear en arrecifes.</li>
            <li>Practicar snorkel.</li>
            <li>Disfrutar de playas paradisíacas.</li>
            <li>Conocer la cultura caribeña.</li>
        </ul>

        <a asp-controller="Destinos"
           asp-action="Index"
           class="destino-btn">
            Volver a Destinos
        </a>

    </div>

</section>

<section class="destino-galeria">

    <h2>Lugares Imperdibles</h2>

    <div class="galeria-grid">

        <div class="galeria-card">
            <img src="/Images/playa-corn-island.jpg" alt="Playa Corn Island">
            <h3>Playas Paradisíacas</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/little-corn-island.jpg" alt="Little Corn Island">
            <h3>Little Corn Island</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/arrecifes-coral.jpg" alt="Arrecifes de Coral">
            <h3>Arrecifes de Coral</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/buceo-corn-island.jpg" alt="Buceo">
            <h3>Buceo y Snorkel</h3>
        </div>

    </div>

    <h2>Gastronomía Típica</h2>

    <div class="galeria-grid">

        <div class="galeria-card">
            <img src="/Images/rondon.jpg" alt="Rondón">
            <h3>Rondón</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/langosta-caribe.jpg" alt="Langosta">
            <h3>Langosta Caribeña</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/pescado-coco.jpg" alt="Pescado al Coco">
            <h3>Pescado al Coco</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/mariscos-frescos.jpg" alt="Mariscos">
            <h3>Mariscos Frescos</h3>
        </div>

    </div>

</section>