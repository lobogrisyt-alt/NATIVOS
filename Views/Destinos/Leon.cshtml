@{
    ViewData["Title"] = "León";
}

<section class="destino-detalle">

    <div class="destino-banner">
        <img src="/Images/leon.png" alt="León">
    </div>

    <div class="destino-info">

        <h1>León</h1>

        <p>
            León es considerada la capital intelectual de Nicaragua.
            Destaca por su historia, cultura, arte y la famosa Catedral de León,
            declarada Patrimonio de la Humanidad.
        </p>

        <h2>¿Qué puedes hacer?</h2>

        <ul>
            <li>Visitar la Catedral de León.</li>
            <li>Practicar sandboarding en Cerro Negro.</li>
            <li>Recorrer museos históricos.</li>
            <li>Disfrutar de la vida cultural de la ciudad.</li>
        </ul>

        <a asp-controller="Destinos"
           asp-action="Index"
           class="destino-btn">
            Volver a Destinos
        </a>

    </div>

</section>

<section class="destino-galeria">

    <h2>Lugares Imperdibles</h2>

    <div class="galeria-grid">

        <div class="galeria-card">
            <img src="/Images/catedral-leon.jpg" alt="Catedral de León">
            <h3>Catedral de León</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/cerro-negro.jpg" alt="Cerro Negro">
            <h3>Cerro Negro</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/recoleccion.jpg" alt="La Recolección">
            <h3>La Recolección</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/museo-ruben-dario.jpg" alt="Museo Rubén Darío">
            <h3>Museo Rubén Darío</h3>
        </div>

    </div>

    <h2>Gastronomía Típica</h2>

    <div class="galeria-grid">

        <div class="galeria-card">
            <img src="/Images/indio-viejo.jpg" alt="Indio Viejo">
            <h3>Indio Viejo</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/vigoron.jpg" alt="Vigorón">
            <h3>Vigorón</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/nacatamal.jpg" alt="Nacatamal">
            <h3>Nacatamal</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/rosquillas.jpg" alt="Rosquillas">
            <h3>Rosquillas</h3>
        </div>

    </div>

</section>