@{
    ViewData["Title"] = "San Juan del Sur";
}

<section class="destino-detalle">

    <div class="destino-banner">
        <img src="/Images/granada.png" alt="San Juan del Sur">
    </div>

    <div class="destino-info">

        <h1>San Juan del Sur</h1>

        <p>
            Uno de los destinos de playa más famosos de Nicaragua,
            conocido por sus olas, vida nocturna y espectaculares atardeceres.
        </p>

        <h2>¿Qué puedes hacer?</h2>

        <ul>
            <li>Practicar surf.</li>
            <li>Visitar el Cristo de la Misericordia.</li>
            <li>Disfrutar de la playa.</li>
            <li>Ver increíbles atardeceres.</li>
        </ul>

        <a asp-controller="Destinos"
           asp-action="Index"
           class="destino-btn">
            Volver a Destinos
        </a>

    </div>

</section>

<section class="destino-galeria">

    <h2>Lugares Imperdibles</h2>

    <div class="galeria-grid">

        <div class="galeria-card">
            <img src="/Images/playa-maderas.jpg" alt="Playa Maderas">
            <h3>Playa Maderas</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/playa-hermosa.jpg" alt="Playa Hermosa">
            <h3>Playa Hermosa</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/cristo-misericordia.jpg" alt="Cristo de la Misericordia">
            <h3>Cristo de la Misericordia</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/bahia-san-juan.jpg" alt="Bahía de San Juan del Sur">
            <h3>Bahía de San Juan</h3>
        </div>

    </div>

    <h2>Gastronomía Típica</h2>

    <div class="galeria-grid">

        <div class="galeria-card">
            <img src="/Images/pescado-a-la-plancha.jpg" alt="Pescado a la Plancha">
            <h3>Pescado a la Plancha</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/camarones.jpg" alt="Camarones">
            <h3>Camarones</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/coctel-mariscos.jpg" alt="Cóctel de Mariscos">
            <h3>Cóctel de Mariscos</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/langosta.jpg" alt="Langosta">
            <h3>Langosta</h3>
        </div>

    </div>

</section>