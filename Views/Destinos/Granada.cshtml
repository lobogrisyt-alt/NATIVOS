@{
    ViewData["Title"] = "Granada";
}

<section class="destino-detalle">

    <div class="destino-banner">
        <img src="/Images/Granada-destino.webp" alt="Granada">
    </div>

    <div class="destino-info">

        <h1>Granada</h1>

        <p>
            Granada es una de las ciudades más antiguas de América.
            Destaca por su arquitectura colonial, calles coloridas,
            cultura, gastronomía y cercanía al Lago Cocibolca.
        </p>

        <h2>¿Qué puedes hacer?</h2>

        <ul>
            <li>Recorrer el centro histórico.</li>
            <li>Visitar las Isletas de Granada.</li>
            <li>Conocer la Catedral de Granada.</li>
            <li>Disfrutar de la gastronomía local.</li>
        </ul>

        <a asp-controller="Destinos"
           asp-action="Index"
           class="destino-btn">
            Volver a Destinos
        </a>

    </div>

</section>

<section class="destino-galeria">

    <h2>Lugares Imperdibles</h2>

    <div class="galeria-grid">

        <div class="galeria-card">
            <img src="/Images/isletas.jpg" alt="Isletas">
            <h3>Isletas de Granada</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/catedral.jpg" alt="Catedral">
            <h3>Catedral</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/calzada.jpg" alt="Calzada">
            <h3>La Calzada</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/mombacho.jpg" alt="Mombacho">
            <h3>Volcán Mombacho</h3>
        </div>

    </div>

    <h2>Gastronomía Típica</h2>

    <div class="galeria-grid">

        <div class="galeria-card">
            <img src="/Images/vigoron.jpg" alt="Vigorón">
            <h3>Vigorón</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/quesillo.jpg" alt="Quesillo">
            <h3>Quesillo</h3>
        </div>

        <div class="galeria-card">
            <img src="/Images/rondon.jpg" alt="Rondón">
            <h3>Rondón</h3>
        </div>

    </div>

</section>