@{
    ViewData["Title"] = "Sobre Nosotros";
}

<link rel="stylesheet" href="~/css/sobre.css" />

<!-- HERO -->
<section class="hero-sobre">

    <div class="overlay"></div>

    <div class="container hero-content">

        <span class="subtitulo">
           
        </span>

        <h1>
            Sobre Nosotros
        </h1>

        <p>
            Descubre la esencia de <strong>Nicaragua</strong> con NATIVOS.
        </p>

    </div>

</section>


<!-- QUIENES SOMOS -->

<section class="quienes py-5">

    <div class="container">

        <div class="titulo">

            <h2>¿Quiénes somos?</h2>

            <p>

                NATIVOS es una plataforma turística creada para promover la
                belleza, cultura, gastronomía y tradiciones de Nicaragua.

                Nuestro objetivo es conectar viajeros nacionales e internacionales
                con experiencias auténticas mediante una plataforma moderna,
                intuitiva y segura.

            </p>

        </div>

        <div class="row mt-5">

            <!-- MISION -->

            <div class="col-lg-4 mb-4">

                <div class="card-sobre">

                    <div class="icono">
                        🏴
                    </div>

                    <h3>Misión</h3>

                    <p>

                        Promover un turismo sostenible, comunitario y de bajo impacto mediante una plataforma digital que conecte a viajeros
                        conscientes con experiencias auténticas en Nicaragua, fortaleciendo las economías locales, preservando
                        la identidad cultural y contribuyendo a la protección del medio ambiente.

                    </p>

                </div>

            </div>


            <!-- VISION -->

            <div class="col-lg-4 mb-4">

                <div class="card-sobre">

                    <div class="icono">
                        👁
                    </div>

                    <h3>Visión</h3>

                    <p>

                        Ser la plataforma líder de turismo sostenible en Nicaragua, reconocida por impulsar experiencias
                        responsables que fortalezcan las comunidades locales, protejan los recursos naturales y promuevan la riqueza cultural del país.

                    </p>

                </div>

            </div>


            <!-- VALORES -->

            <div class="col-lg-4 mb-4">

                <div class="card-sobre">

                    <div class="icono">
                        ❤
                    </div>

                    <h3>Valores</h3>

                    <p>

                        Cultura, respeto, innovación, responsabilidad,
                        sostenibilidad y pasión por Nicaragua.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- ESTADISTICAS -->

<section class="estadisticas">

    <div class="container">

        <div class="row text-center">

            <div class="col-md-4">

                <h2>50+</h2>

                <p>Destinos turísticos</p>

            </div>

            <div class="col-md-4">

                <h2>100%</h2>

                <p>Experiencias auténticas</p>

            </div>

            <div class="col-md-4">

                <h2>24/7</h2>

                <p>Información disponible</p>

            </div>

        </div>

    </div>

</section>