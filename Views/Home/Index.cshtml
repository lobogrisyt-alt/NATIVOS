@{
    ViewData["Title"] = "Inicio";
}

<section class="hero">

    
    <div class="hero-slider">
        <img id="sliderImage" src="/images/granada-portada.jpg" alt="Nicaragua">
    </div>

    <div class="hero-content">

        <div class="hero-text">

            <h1>
                Conecta con <br />
                <span>lo auténtico</span>
            </h1>

            <p>
                Descubre destinos únicos, experiencias inolvidables y la magia de nuestra tierra.
            </p>

            <div class="hero-buttons">
                <a asp-controller="Destinos"
                   asp-action="Index"
                   class="btn-primary">
                    Explorar destinos
                </a>
                <a href="#" class="btn-secondary">Conoce más</a>
            </div>

        </div>

        

    </div>
    

</section>

    

</section>

<script>

    const images = [
        "/images/granada-portada.jpg",
        "/images/ometepe.png",
        "/images/leon.png"
    ];

    let current = 0;

    setInterval(() => {

        current++;

        if (current >= images.length) {
            current = 0;
        }

        document.getElementById("sliderImage").src = images[current];

    }, 5000);

</script>
