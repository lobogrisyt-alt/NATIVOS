@{
    ViewData["Title"] = "Crear cuenta";
}

<section class="login-page">

    <div class="login-frame">

    

        <div class="login-container">

            <h1>Crear cuenta</h1>

            <form asp-controller="Home" asp-action="Registro2" method="post">

                <input type="text"
                       name="nombre"
                       placeholder="Nombre"
                       required />

                <input type="text"
                       placeholder="Primer apellido"
                       required />

                <input type="text"
                       placeholder="Segundo apellido" />

                <input type="tel"
                       placeholder="Número de celular"
                       required />

                <input type="email"
                       name="correo"
                       placeholder="Correo electrónico"
                       required />

                <input type="date"
                       required />

                <select required>
                    <option value="">Seleccione el sexo</option>
                    <option>Masculino</option>
                    <option>Femenino</option>
                </select>

                <input type="password"
                       name="contrasena"
                       placeholder="Contraseña"
                       required />

                <input type="password"
                       placeholder="Confirmar contraseña"
                       required />

                <button type="submit">
                    Crear cuenta
                </button>

            </form>

            <p class="back-login">
                <a asp-controller="Home"
                   asp-action="Login">
                    ← Volver al inicio de sesión
                </a>
            </p>

        </div>

    </div>

</section>