@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="login-page">

    <div class="login-frame">

    

        <img src="~/Images/sacuanjoche.png" class="flor flor-1">

        <img src="~/Images/sacuanjoche.png" class="flor flor-2">

        <img src="~/Images/guardabarranco.png" class="guardabarranco">

        <img src="~/Images/guardabarranco.png" class="guardabarranco-2">

        <div class="login-container">

            <h1>Inicia sesión</h1>

            <form asp-controller="Home" asp-action="Login" method="post">

                <div class="input-group">
                    <i class="bi bi-envelope"></i>

                    <input type="email"
                           name="correo"
                           placeholder="Correo electrónico"
                           required />
                </div>

                <div class="input-group">
                    <i class="bi bi-lock"></i>

                    <input type="password"
                           name="contrasena"
                           placeholder="Contraseña"
                           required />
                </div>

                <div class="forgot-container">
                    <a asp-controller="Home"
                       asp-action="RecuperarContrasena"
                       class="forgot-password">
                        ¿Olvidaste tu contraseña?
                    </a>
                </div>

                <button type="submit">
                    Ingresar
                </button>

            </form>

            <p class="register-text">
                ¿No tienes cuenta?
                <a asp-controller="Home"
                   asp-action="Registro2">
                    Regístrate
                </a>
            </p>



        </div>

    </div>

</section>