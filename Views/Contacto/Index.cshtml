@{
    ViewData["Title"] = "Contacto";
}

<link rel="stylesheet" href="~/css/contacto.css" />

<section class="hero-contacto">
    <div class="overlay"></div>

    <div class="hero-content">
        <h1>Contacto</h1>

        <p>
            Estamos aquí para ayudarte.<br />
            Contáctanos por cualquiera de nuestros canales.
        </p>
    </div>
</section>

<section class="contacto">

    <div class="container">

        <h2>Información de Contacto</h2>

        <div class="linea2"></div>

        <p class="descripcion">
            Puedes comunicarte con nosotros a través de cualquiera
            de nuestros canales. Estamos listos para atenderte.
        </p>

        <div class="cards">

            <div class="card-contacto">
                <div class="icono">
                    <i class="bi bi-geo-alt-fill"></i>
                </div>

                <h4>Dirección</h4>

                <p>
                    Managua, Nicaragua<br />
                    Distrito I, Altamira
                </p>
            </div>

            <div class="card-contacto">
                <div class="icono">
                    <i class="bi bi-envelope-fill"></i>
                </div>

                <h4>Correo Electrónico</h4>

                <p>info@nativos.com</p>
            </div>

            <div class="card-contacto">
                <div class="icono">
                    <i class="bi bi-telephone-fill"></i>
                </div>

                <h4>Teléfono</h4>

                <p>+505 8888 8888</p>
            </div>

            <div class="card-contacto">
                <div class="icono">
                    <i class="bi bi-clock-fill"></i>
                </div>

                <h4>Horario de Atención</h4>

                <p>
                    Lunes - Viernes<br />
                    8:00 AM - 5:00 PM
                </p>
            </div>

        </div> <!-- cards -->

    </div> <!-- container -->

</section> <!-- contacto -->